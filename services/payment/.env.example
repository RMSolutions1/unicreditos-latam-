PORT=3103
WEB_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
JWT_ACCESS_SECRET=
DATABASE_URL=

MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_NOTIFICATION_URL=

# AstroPay Checkout (Offsite) -- convive con Mercado Pago para AR (el cliente elige el proveedor
# al crear el PaymentIntent; sin preferencia, el default es Mercado Pago). ENABLE_ASTROPAY=true
# es un kill-switch aparte de tener credenciales: hoy nunca se probo un pago ni un webhook de
# punta a punta contra AstroPay (sin sandbox disponible), asi que dejalo en false hasta estar
# listos para que trafico real le pegue. ASTROPAY_ENV=sandbox|production, default sandbox.
ENABLE_ASTROPAY=false
ASTROPAY_ENV=sandbox
ASTROPAY_CLIENT_ID=
ASTROPAY_CLIENT_SECRET=
ASTROPAY_AUTH_BASE_URL=
ASTROPAY_API_BASE_URL=

RESEND_API_KEY=
EMAIL_FROM=UNICRÉDITOS <no-responder@unicreditos.com>
