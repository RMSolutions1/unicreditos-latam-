PORT=3103
WEB_ORIGIN=http://localhost:5175
PUBLIC_SITE_URL=http://localhost:5175
JWT_ACCESS_SECRET=
DATABASE_URL=

MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_NOTIFICATION_URL=

# AstroPay Checkout (Offsite) -- convive con Mercado Pago para AR (el cliente elige el proveedor
# al crear el PaymentIntent; sin preferencia, el default es Mercado Pago). ENABLE_ASTROPAY=true
# es un kill-switch aparte de tener credenciales: confirmado en vivo contra sandbox que un unico
# host (partners-api.astropay.com) sirve auth + certificados + pagos, y se corrigio el body de
# POST /v1/payments contra la referencia autoritativa real (method=CHECKOUT, order.id). Sigue sin
# probarse un pago + webhook de punta a punta -- dejalo en false hasta confirmar eso.
ENABLE_ASTROPAY=false
ASTROPAY_CLIENT_ID=
ASTROPAY_CLIENT_SECRET=
ASTROPAY_BASE_URL=
ASTROPAY_NOTIFICATION_URL=

RESEND_API_KEY=
EMAIL_FROM=UNICRÉDITOS <no-responder@unicreditos.com>
