// UNICRÉDITOS — esquema Fase 1 (identidad, RBAC, auditoría).
// Los dominios de credito/pagos/ledger se agregan en fases siguientes (ver docs/DATABASE.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  CEO
  CFO
  CTO
  RISK_MANAGER
  COMPLIANCE_MANAGER
  TREASURY_MANAGER
  COLLECTION_MANAGER
  OPERATIONS_MANAGER
  SUPPORT
  AUDITOR
  ANALYST
  MERCHANT_ADMIN
  CUSTOMER
  INVESTOR
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  BLOCKED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?
  passwordHash String     @map("password_hash")
  mfaEnabled   Boolean    @default(false) @map("mfa_enabled")
  mfaSecret    String?    @map("mfa_secret")
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  lastLoginAt  DateTime?  @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// Append-only por diseño: sin updatedAt/deletedAt, sin endpoint DELETE (ver docs/SECURITY.md §9).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  actor      User?    @relation(fields: [actorId], references: [id])
  actorRole  String   @map("actor_role")
  action     String
  resource   String
  resourceId String   @map("resource_id")
  before     Json?
  after      Json?
  ip         String?
  device     String?
  requestId  String   @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([resource, resourceId])
  @@index([actorId])
  @@map("audit_logs")
}
